{
	"schemaVersion": 1,
	"id": "fishonmcextras",
	"version": "${version}",
	"name": "FishOnMCExtras",
	"description": "FishOnMC-Extras-Reborn/Rework/Rebirth. Ultimately a new FoE mod from scratch. Clutter free, modern code, easy to contribute and no stress on server updates",
	"authors": [
		"DannyPX"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/fishonmcextras/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dannypx.foe.FishOnMCExtras"
		],
		"client": [
			"dannypx.foe.FishOnMCExtrasClient"
		]
	},
	"mixins": [
		"fishonmcextras.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": ">=0.141.3+1.21.11",
		"fzzy_config": ">=0.7.6+1.21.11"
	},
	"custom": {
		"fzzy_config": [
			"fishonmcextras"
		],
		"hud_version": 3,
		"hud_icon_version": 1,
		"button_version": 1,
		"notification_version": 2,
		"chat_notification_version": 1,
		"chat_trigger_version": 3,
		"timer_version": 3,
		"event_trigger_version": 2,
		"tracker_version": 2,
